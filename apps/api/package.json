{
  "name": "@maxcloud/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch -r @swc-node/register src/main.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "worker": "node dist/worker.js",
    "dev:worker": "node --env-file-if-exists=.env --watch -r @swc-node/register src/worker.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "openapi": "node -r @swc-node/register src/openapi/generate.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "7.3.4",
    "@aws-sdk/client-s3": "3.1164.0",
    "@aws-sdk/s3-request-presigner": "3.1164.0",
    "@maxcloud/shared": "workspace:*",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@prisma/client": "6.19.3",
    "@sentry/nestjs": "10.78.0",
    "argon2": "0.45.2",
    "bullmq": "5.81.5",
    "cookie-parser": "1.4.7",
    "express": "5.1.0",
    "helmet": "8.1.0",
    "ioredis": "5.11.1",
    "jose": "6.2.16",
    "nestjs-pino": "4.6.1",
    "nodemailer": "7.0.13",
    "otplib": "12.0.1",
    "pdfkit": "0.17.2",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "prom-client": "15.1.3",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.34.5",
    "stripe": "18.5.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@swc-node/register": "1.12.1",
    "@swc/core": "1.16.22",
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.6",
    "@types/node": "22.18.0",
    "@types/nodemailer": "7.0.2",
    "@types/pdfkit": "0.17.3",
    "@types/qrcode": "1.5.5",
    "@types/supertest": "6.0.3",
    "pino-pretty": "13.1.1",
    "prisma": "6.19.3",
    "supertest": "7.1.4",
    "tsx": "4.20.5",
    "typescript": "5.9.3",
    "unplugin-swc": "1.6.0",
    "vitest": "3.2.7"
  }
}
