{
  "name": "maxcloud",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm --filter @maxcloud/shared build && pnpm -r --parallel --filter @maxcloud/api --filter @maxcloud/web dev",
    "dev:setup": "bash scripts/dev-setup.sh",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "e2e": "pnpm --filter @maxcloud/web e2e",
    "db:seed": "pnpm --filter @maxcloud/api db:seed",
    "openapi": "pnpm --filter @maxcloud/api openapi"
  }
}
